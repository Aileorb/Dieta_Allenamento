// Di&T su Cloudflare Workers: l'app statica (questa cartella) + /api per le notifiche di fine recupero
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dieta-allenamento",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TIMER", "class_name": "Timer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Timer"] }],
  "observability": { "enabled": true }
}
